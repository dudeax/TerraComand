Configs: {
	TerraCommandConfig: {
		DisplayName: Terra Command

		Headers: {
			Conversion: Conversion
			Terrain: Terrain
			Bodies: Bodies
			Units: Units
		}

		ConversionMode: {
			Label: Full conversion
			Tooltip: Suppresses ambient Terraria spawns and removes vanilla tools from newly created characters. The enemy faction provides combatants. Existing characters and enemies are preserved.
		}

		PixelMining: {
			Label: Pixel mining
			Tooltip: Pickaxes carve the pixels nearest the cursor instead of chipping whole tiles
		}

		PixelExplosions: {
			Label: Pixel explosions
			Tooltip: Explosives leave round craters instead of removing whole tiles
		}

		ProjectilesChipTerrain: {
			Label: Projectiles chip terrain
			Tooltip: Bullets, arrows and other projectiles chip away terrain where they hit
		}

		CrumbleThreshold: {
			Label: Crumble threshold
			Tooltip: Fraction of a tile's pixels that must be removed before the rest collapses
		}

		NaturalLifeRegen: {
			Label: Natural health regeneration
			Tooltip: Off (Cortex Command style): bodies only heal from potions, buffs and accessories
		}

		TransferControlOnDeath: {
			Label: Transfer control on death
			Tooltip: When your body dies, control jumps to your nearest idle body instead
		}

		MaxUnitsPerTeam: {
			Label: Max bodies per team
			Tooltip: How many idle bodies each team can have at once
		}

		EnemyFaction: {
			Label: Enemy AI faction
			Tooltip: An enemy brain digs in somewhere in the world and sends dropships of soldiers to hunt your brain. Destroy it to win the world.
		}

		EnemyFirstAttackMinutes: {
			Label: Minutes before the first enemy attack
			Tooltip: How long after the enemy brain arrives before its first dropship comes for you
		}

		EnemyAttackMinutes: {
			Label: Minutes between enemy attacks
			Tooltip: How often the enemy sends a dropship (if it can afford one)
		}
	}
}
